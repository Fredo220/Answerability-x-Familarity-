{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Familiarity Answerability Candidate Entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entity_id", "qid", "name", "coarse_type", "split", "source_query", "source_provenance", "screening_aliases"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "entity_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "qid": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
    "name": {"type": "string", "minLength": 1},
    "coarse_type": {"type": "string", "minLength": 1},
    "split": {"enum": ["pilot", "mechanism_train", "locked_validation", "behavior_test", "probe_test", "intervention_test", "circuit_dev"]},
    "source_query": {"type": "string", "minLength": 1},
    "source_provenance": {"type": "string", "minLength": 1},
    "screening_aliases": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}
  }
}
