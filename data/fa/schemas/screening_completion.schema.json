{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Familiarity Answerability Screening Completion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "entity_id",
    "qid",
    "question_id",
    "question_index",
    "prompt",
    "accepted_aliases",
    "source_provenance",
    "rendered_prompt_sha256",
    "raw_output",
    "answer_text",
    "generation",
    "config_sha256",
    "model_sha256",
    "tokenizer_sha256",
    "chat_template_sha256",
    "status",
    "exception_class"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "screening_completion"},
    "entity_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "qid": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
    "question_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "question_index": {"type": "integer", "minimum": 0, "maximum": 2},
    "prompt": {"type": "string", "minLength": 1},
    "accepted_aliases": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "source_provenance": {"type": "string", "minLength": 1},
    "rendered_prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_output": {"type": ["string", "null"]},
    "answer_text": {"type": ["string", "null"]},
    "generation": {"type": "object"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tokenizer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chat_template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["completed", "infrastructure_failure"]},
    "exception_class": {"type": ["string", "null"]}
  }
}
