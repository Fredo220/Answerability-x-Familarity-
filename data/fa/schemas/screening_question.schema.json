{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Familiarity Answerability Screening Question",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question_id", "qid", "prompt", "accepted_aliases", "source_provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "question_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "qid": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
    "prompt": {"type": "string", "minLength": 1},
    "accepted_aliases": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "source_provenance": {"type": "string", "minLength": 1}
  }
}
